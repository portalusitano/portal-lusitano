{
  "name": "portal-lusitano",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "images:refresh": "node -e \"const{rmSync,existsSync}=require('fs');const p='.next/cache/images';if(existsSync(p)){rmSync(p,{recursive:true,force:true});console.log('✓ Cache de imagens limpa. Reinicia o servidor para aplicar.')}else{console.log('Nenhum cache para limpar.')}\"",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true next build",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:run": "playwright test --workers=1",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "db:types": "npx supabase gen types typescript --project-id yrfcepsagtzkxwnnrztd > lib/database.types.ts",
    "generate-pdf": "node scripts/generate-ebook-pdf.js",
    "generate-pdf:premium": "node scripts/generate-ebook-pdf-premium.js",
    "sync-images": "node scripts/sync-coudelaria-images.js",
    "sync-cavalos": "npx tsx scripts/sync-cavalos-images.ts",
    "optimize-images": "npx tsx scripts/optimize-images.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@portabletext/react": "^6.0.2",
    "@react-email/components": "^1.0.7",
    "@react-pdf/renderer": "^4.3.2",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.0.3",
    "@sanity/vision": "^5.9.0",
    "@sentry/nextjs": "^10.38.0",
    "@stripe/stripe-js": "^8.7.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "html2canvas": "^1.4.1",
    "jose": "^6.1.3",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lenis": "^1.3.18",
    "lru-cache": "^11.2.5",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^6.6.0",
    "next": "^16.1.6",
    "next-sanity": "^12.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.1",
    "sanitize-html": "^2.17.1",
    "sanity": "^5.9.0",
    "sharp": "^0.34.5",
    "stripe": "^20.3.0",
    "tailwind-merge": "^3.4.0",
    "topojson-client": "^3.1.0",
    "web-vitals": "^5.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.1.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "md-to-pdf": "^5.2.5",
    "prettier": "^3.8.1",
    "supabase": "^2.76.15",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
